# Journal data. These are real diary entries — never commit them.
*.csv
*.db

# Signing keys. Losing these means never being able to update the app on
# Play again; committing them to a public repo means anyone can forge it.
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# Design docs and plans — kept locally, not published. This repository is
# public and design documents are not.
docs/
design/

