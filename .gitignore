# Journal data. These are real diary entries — never commit them.
*.csv
*.db

# Build output
*.apk
*.aab
/remindiary

# Signing keys. Losing these means never being able to update the app on
# Play again; committing them to a public repo means anyone can forge it.
*.keystore
*.jks
*.p12

# fyne rewrites FyneApp.toml on every build; the Makefile snapshots it here.
.FyneApp.toml.bak

# Generated from AndroidManifest.xml.in at build time.
cmd/remindiary/AndroidManifest.xml

# Go
*.test
*.out

# Design docs and plans — kept locally, not published.
docs/

# Design docs and plans for the React Native app, same rule as docs/ above:
# kept locally, not published.
app/design/
