<?xml version="1.0" encoding="utf-8"?>
<!--
	Template for the Android manifest. `make apk` / `make release` substitute
	@VERSION_CODE@ and @VERSION_NAME@ and write AndroidManifest.xml beside this
	file; fyne uses that file verbatim instead of generating one from its own
	template (see fyne tools, mobile/build_androidapp.go: it reads
	AndroidManifest.xml from the main package directory when present).

	The reason to override fyne's template at all: it declares INTERNET,
	READ_EXTERNAL_STORAGE and WRITE_EXTERNAL_STORAGE for every app built with
	it. ReminDiary uses none of them — it has no networking code and writes only
	to app-private storage — and an offline journal asking for the internet is a
	fair thing for a user to refuse to install.

	Do NOT add android:icon here. fyne injects it, and errors out with "manual
	declaration of android:icon in AndroidManifest.xml not supported" if it is
	already present.

	uses-sdk is deliberately absent: fyne synthesises it from its own target,
	which is 35 under `fyne release` and 29 under `fyne package`.
-->
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	package="xyz.hub13.remindiary"
	android:versionCode="@VERSION_CODE@"
	android:versionName="@VERSION_NAME@">

	<application android:label="ReminDiary" android:debuggable="false"
				 android:allowBackup="false">
	<activity android:name="org.golang.app.GoNativeActivity"
		android:label="ReminDiary"
		android:configChanges="orientation|keyboardHidden|uiMode"
		android:exported="true"
		android:theme="@android:style/Theme">
		<meta-data android:name="android.app.lib_name" android:value="ReminDiary" />
		<intent-filter>
			<action android:name="android.intent.action.MAIN" />
			<category android:name="android.intent.category.LAUNCHER" />
		</intent-filter>
	</activity>

	<receiver android:name="org.golang.app.FyneNotificationReceiver"
			  android:exported="false" />
	</application>
</manifest>
